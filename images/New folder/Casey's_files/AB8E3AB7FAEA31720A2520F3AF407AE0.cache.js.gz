	var ENDPOINT_URL = "/ws";
	var PATH = "/v7/socket.io.v2";
	var FILES_MESSAGES_ROOM = "files-messages";
	var FILE_UPLOAD_SUCCESS_EVENT = "FileUploadedSuccess";
	var FILE_METADATA_EXTRACTED_EVENT = "FileMetadataExtracted";
	var FILE_THUMBNAIL_EXTRACTED_EVENT = "UIThumbnailGeneratedEvent";
	var TIMEOUT_ON_JOIN_ROOM = 6e4 * 2;
	var WebSocketClient = class {
		#logger;
		#rooms = {};
		#socket;
		#getAccessToken;
		constructor({ getAccessToken, logger }) {
			this.#getAccessToken = getAccessToken ?? void 0;
			this.#logger = logger;
			const aid = v4();
			const setting = {
				timeout: 5e3,
				path: PATH,
				extraHeaders: { "x-socket-io-affinity-id": aid },
				query: { aid },
				reconnectionDelay: 2e3,
				reconnectionDelayMax: 1e4,
				transports: ["polling", "websocket"]
			};
			this.#socket = lookup(ENDPOINT_URL, setting);
		}
		#setToken = async () => {
			const token = await this.#getAccessToken?.();
			if (token) this.#socket.auth = { token };
		};
		async init() {
			await this.#setToken();
			let retryCount = 0;
			return new Promise((res, rej) => {
				this.#socket.on("connect", () => {
					this.#logger.debug("WebSocket - Connected to socket");
					this.#rejoinRooms();
					retryCount = 0;
					res();
				});
				this.#socket.on("disconnect", async (reason, description) => {
					if (this.#socket.active) {
						this.#logger.debug("WebSocket - Disconnected, waiting for reconnection", {
							reason,
							description
						});
						return;
					}
					this.#logger.error("WebSocket - Disconnected from socket, reconnecting", {
						reason,
						description
					});
					await this.#setToken();
					this.#socket.connect();
				});
				this.#socket.on("connect_error", (error) => {
					if (this.#socket.active) {
						this.#logger.debug("WebSocket - Connect error, waiting for reconnection", { ...error });
						retryCount++;
						if (retryCount === 10) {
							this.#logger.error("WebSocket - Too many connection errors", {
								rooms: { ...this.#rooms },
								error: error.message
							});
							rej(new Error("WebSocket - Connect error", { cause: error }));
						}
						return;
					}
					this.#logger.error("WebSocket - Server rejected connection", { ...error });
					rej(new Error("WebSocket - Connect error", { cause: error }));
				});
				this.#socket.connect();
			});
		}
		async #joinRoom(fileId, options) {
			if (this.#rooms[fileId] && !options?.force) return Promise.resolve();
			this.#rooms[fileId] = true;
			const roomName = `${FILES_MESSAGES_ROOM}_${fileId}`;
			this.#logger.debug(`WebSocket - Joining room ${roomName}`);
			await new Promise((res) => {
				this.#socket.once(`joined ${roomName}`, res);
				this.#socket.emit("join", roomName);
			});
			this.#logger.debug(`WebSocket - Joined room ${roomName}`);
		}
		#rejoinRooms() {
			Object.keys(this.#rooms).forEach((roomName) => {
				this.#joinRoom(roomName, { force: true });
			});
		}
		async listenFileEvents(fileId) {
			const timeout = setTimeout(() => {
				throw new Error(`WebSocket - Timeout while waiting for socket connection for fileId: ${fileId}`);
			}, TIMEOUT_ON_JOIN_ROOM);
			await this.#joinRoom(fileId);
			clearTimeout(timeout);
		}
		async listenForFileUploadSuccess(fileId) {
			await this.listenFileEvents(fileId);
			return new Promise((res) => {
				this.#socket.on(FILE_UPLOAD_SUCCESS_EVENT, (payload) => {
					if (JSON.parse(payload)?.aggregate_root_id !== fileId) return;
					this.#logger.debug("WebSocket - File upload success", { fileId });
					res();
				});
			});
		}
		async listenForMetadata(fileId) {
			await this.listenFileEvents(fileId);
			return new Promise((res) => {
				this.#socket.on(FILE_METADATA_EXTRACTED_EVENT, (payload) => {
					const data = JSON.parse(payload);
					if (data?.aggregate_root_id !== fileId) return;
					if (!data?.metadata) {
						this.#logger.error("WebSocket - File metadata is missing", {
							fileId,
							data
						});
						return;
					}
					this.#logger.debug("WebSocket - File metadata extracted", {
						fileId,
						data
					});
					res(data.metadata);
				});
			});
		}
		async listenForThumbnail(fileId) {
			await this.listenFileEvents(fileId);
			return new Promise((res) => {
				this.#socket.on(FILE_THUMBNAIL_EXTRACTED_EVENT, (payload) => {
					const data = JSON.parse(payload);
					if (data?.aggregate_root_id !== fileId) return;
					if (!data?.thumbnail_file_uri) {
						this.#logger.error("WebSocket - File thumbnail url is missing", { fileId });
						return;
					}
					this.#logger.debug("WebSocket - File thumbnail extracted", { fileId });
					res(data.thumbnail_file_uri);
				});
			});
		}
		closeFileEvents(fileId) {
			const roomName = `${FILES_MESSAGES_ROOM}_${fileId}`;
			if (!this.#rooms[fileId]) return;
			delete this.#rooms[fileId];
			this.#socket.emit("leave", roomName);
			this.#logger.debug(`Left room ${roomName}`);
		}
	};
	function defaultWebSocketProvider(props) {
		const webSocketClient = new WebSocketClient(props);
		webSocketClient.init().catch((error) => {
			props.logger.error("WebSocket - Failed to initialize WebSocketClient", { error });
		});
		return webSocketClient;
	}
