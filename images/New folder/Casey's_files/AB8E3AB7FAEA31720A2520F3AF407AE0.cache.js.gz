                if (a.length) {
                    a.removeClass('focus');
                    if (f === 'incrementHours') {
                        a.filter('[data-action=incrementHours]').addClass('focus');
                    } else if (f === 'incrementMinutes') {
                        a.filter('[data-action=incrementMinutes]').addClass('focus');
                    } else if (f === 'decrementHours') {
                        a.filter('[data-action=decrementHours]').addClass('focus');
                    } else if (f === 'decrementMinutes') {
                        a.filter('[data-action=decrementMinutes]').addClass('focus');
