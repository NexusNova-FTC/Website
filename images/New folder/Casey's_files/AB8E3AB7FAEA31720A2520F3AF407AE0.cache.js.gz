        }
      });
    }

    function initTextarea() {
      elmInputBox = $(domInput);

      if (elmInputBox.attr('data-mentions-input') == 'true') {
        return;
      }

      elmInputWrapper = elmInputBox.parent();
      elmWrapperBox = $(settings.templates.wrapper());
      elmInputBox.wrapAll(elmWrapperBox);
      elmWrapperBox = elmInputWrapper.find('> .mentions-input-box');

      elmInputBox.attr('data-mentions-input', 'true');
      elmInputBox.on('keydown.mentionsInput', onInputBoxKeyDown);
      elmInputBox.on('input.mentionsInput', onInputBoxInput);
      elmInputBox.on('click.mentionsInput', onInputBoxClick);
      elmInputBox.on('blur.mentionsInput', onInputBoxBlur);
    }

    function initAutocomplete() {
      elmAutocompleteList = $(settings.templates.autocompleteList());
      elmAutocompleteList.appendTo(elmWrapperBox);
      elmAutocompleteList.on('mousedown.mentionsInput', 'li.mentions-input-result', onAutoCompleteItemClick);
    }

    function initMentionsOverlay() {
      elmMentionsOverlay = $(settings.templates.mentionsOverlay());
      elmMentionsOverlay.css('font', elmInputBox.css('font'));
      elmMentionsOverlay.prependTo(elmWrapperBox);
    }

    function updateValues() {
      var syntaxMessage = getInputBoxValue();

      mentionsCollection.forEach(function (mention) {
        var textSyntax = settings.templates.mentionItemSyntax(mention);
