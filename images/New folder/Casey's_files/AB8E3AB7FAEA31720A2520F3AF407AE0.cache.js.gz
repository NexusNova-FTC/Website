  var defaultSettings = {
    triggerChar   : '@',
    onDataRequest : $.noop,
    onMentionAdd  : $.noop,
    onUpdate      : $.noop,
    minChars      : 2,
    showAvatars   : true,
    classes       : {
      autoCompleteItemActive : "active"
    },
    templates     : {
      wrapper                    : '<div class="mentions-input-box"></div>',
      autocompleteList           : '<div class="mentions-autocomplete-list"></div>',
      autocompleteListItem       : '<li class="mentions-input-result" data-ref-id="<%= id %>" data-ref-type="<%= type %>" data-display="<%= display %>"><%= content %></li>',
      autocompleteListItemAvatar : '<img src="<%= avatar %>" />',
      autocompleteListItemIcon   : '<div class="icon <%= icon %>"></div>',
      autocompleteListSeperator  : '<li class="mentions-input-seperator"><%= content %></li>',
      mentionsOverlay            : '<div class="mentions"><div></div></div>',
      mentionItemSyntax          : '@[<%= value %>](<%= type %>:<%= id %>)',
      mentionItemHighlight       : '<strong><span><%= value %></span></strong>'
