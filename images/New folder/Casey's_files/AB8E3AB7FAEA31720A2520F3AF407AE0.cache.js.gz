				await this.uploader.tus.abort();
				const fingerprint = await this.uploader.tus.options.fingerprint?.(this.#file, {}) || "";
				await this.uploader.tus.options.urlStorage?.removeUpload(fingerprint);
				this.#getWebSocket().closeFileEvents(this.#resumablePayload.storageObjectId);
				this.#getWebSocket().closeFileEvents(this.#resumablePayload.assetId);
			}
		}
		async retriggerMetadataExtraction() {
			if (!this.#strategy.extraction.enabled || !this.#callbacks.onMetadata) return;
			if (this.#resumablePayload.isUploadComplete) {
				await this.#listenForFileEvents();
				try {
					const ctx = this.#buildTargetContext();
					await this.#strategy.extraction.triggerMetadata(ctx);
				} catch (error) {
					this.#callbacks.onError(error, { description: "Failed to retrigger metadata extraction" });
				}
			}
		}
		async retriggerThumbnailGeneration() {
			if (!this.#strategy.extraction.enabled || !this.#callbacks.onThumbnail) return;
			if (this.#resumablePayload.isUploadComplete) {
				await this.#listenForFileEvents();
				try {
					const ctx = this.#buildTargetContext();
					const thumbnailUrl = await this.#strategy.extraction.triggerThumbnail(ctx);
					if (thumbnailUrl) this.#callbacks.onThumbnail?.(thumbnailUrl);
				} catch (error) {
					this.#callbacks.onError(error, { description: "Failed to retrigger thumbnail generation" });
				}
			}
		}
	};
	function createAssetServiceAdapter(file, options) {
		return new AssetServiceAdapter(file, options);
	}
	//#endregion
	//#region src/adapters/file-service/constants.ts
	var MAX_QUEUED_CHUNK_TIME = 600 * 1e3;
	var BASE_PRIVATE_PATH = "/v7/file_cmds/upload";
	var BASE_PUBLIC_PATH = "/v7/public_file_cmds/upload";
	var DEFAULT_CHUNK_SIZE = 5 * 1024 * 1024;
	var MAX_CHUNK_SIZE = 100 * 1024 * 1024;
	//#endregion
	//#region src/adapters/file-service/utils.ts
	function getEndpoints(options) {
		const { isPublic = true } = options ?? {};
		const path = isPublic ? BASE_PUBLIC_PATH : BASE_PRIVATE_PATH;
		return {
			prepare: () => `${path}/prepare`,
			upload: (fileId, chunkNumber) => `${path}/${fileId}/chunk/${chunkNumber}`,
			finalise: (fileId) => `${path}/${fileId}/finalise`
		};
	}
	async function hashBlob(blob) {
		const buffer = await blob.arrayBuffer();
		const hash = await crypto.subtle.digest("SHA-256", buffer);
		return Array.from(new Uint8Array(hash)).map((byte) => byte.toString(16).padStart(2, "0")).join("");
	}
	async function getChunk(blob, chunkNumber, chunkSize) {
		const chunkStart = chunkNumber * chunkSize;
		const chunkEnd = chunkStart + chunkSize;
		const chunk = blob.slice(chunkStart, chunkEnd);
		return {
			chunk,
			hash: await hashBlob(chunk)
		};
	}
	async function uploadWithProgress(url, options, retries = 3) {
		for (let retryNumber = 0; retryNumber < retries; retryNumber++) try {
			await new Promise((resolve, reject) => {
				const xhr = new XMLHttpRequest();
				xhr.open("POST", url);
				options.signal?.addEventListener("abort", () => {
					xhr.abort();
				});
				xhr.upload.addEventListener("progress", (event) => {
					if (event.lengthComputable && options?.onProgress) options.onProgress(event.loaded);
				});
				xhr.upload.addEventListener("loadend", (event) => {
					if (event.lengthComputable && options?.onProgress) options.onProgress(event.loaded);
				});
				xhr.addEventListener("loadend", () => {
					if (xhr.status < 200 || xhr.status >= 300) reject(new Error(xhr.statusText));
					else resolve(xhr.response);
				});
				function onError(event) {
					reject(new Error(event.type));
				}
				xhr.addEventListener("error", onError);
				xhr.addEventListener("abort", onError);
				xhr.addEventListener("timeout", onError);
				Object.entries(options.headers).forEach(([key, value]) => {
					xhr.setRequestHeader(key, value);
				});
				xhr.send(options.body);
			});
			break;
		} catch (error) {
			if (retryNumber === retries - 1 || options.signal?.aborted) throw error;
			await new Promise((resolve) => setTimeout(resolve, 2 * retryNumber * 1e3));
		}
	}
	function getChunksStatusMap(file, chunkSize) {
		const totalChunks = Math.ceil(file.size / chunkSize);
		const chunksStatus = /* @__PURE__ */ new Map();
		for (let chunkNumber = 0; chunkNumber < totalChunks; chunkNumber++) {
			const chunkStart = chunkNumber * chunkSize;
			const totalSize = chunkStart + chunkSize > file.size ? file.size - chunkStart : chunkSize;
			chunksStatus.set(chunkNumber, {
				size: totalSize,
				loaded: 0
			});
		}
		return chunksStatus;
	}
	function getTotalUploaded(chunksStatus) {
		return Array.from(chunksStatus.values()).reduce((total, { loaded }) => total + loaded, 0);
	}
	function waitTimeout(ms, abortSignal) {
		return new Promise((resolve) => setTimeout(resolve, ms, abortSignal));
	}
	async function waitUploadChunkSlot(getUploadingChunks, startTime, abortSignal) {
		const isSlotAvailable = getUploadingChunks() < 4;
		const isWaitingTimeExceeded = Date.now() - startTime > MAX_QUEUED_CHUNK_TIME;
		if (isSlotAvailable) return;
		if (isWaitingTimeExceeded) throw new Error("Max queued time exceeded while waiting to upload chunk");
		await waitTimeout(100, abortSignal);
		return waitUploadChunkSlot(getUploadingChunks, startTime, abortSignal);
	}
	async function waitForCompletion(isDone, abortSignal) {
		if (isDone()) return;
		await waitTimeout(100, abortSignal);
		return waitForCompletion(isDone, abortSignal);
	}
	//#endregion
	//#region src/adapters/file-service/legacyChunkSize.ts
	function getLegacyChunkSize() {
		const settingValue = Number(window.bynder?.Uploader?.chunkSize);
		if (isNaN(settingValue)) return DEFAULT_CHUNK_SIZE;
		if (settingValue < 5242880) return DEFAULT_CHUNK_SIZE;
		if (settingValue > 104857600) return MAX_CHUNK_SIZE;
		return settingValue;
	}
	//#endregion
	//#region src/adapters/file-service/api.ts
	function fileServiceApi({ intent, logger, getAuthorizationToken }) {
		const isPublic = !getAuthorizationToken;
		const endpoints = getEndpoints({ isPublic });
		const chunkSize = getLegacyChunkSize();
		async function getAuthHeader() {
			return !isPublic ? { Authorization: `Bearer ${await getAuthorizationToken?.()}` } : {};
		}
		async function uploadChunk({ fileId, file, chunkNumber, abortSignal, onProgress }) {
			const authHeader = await getAuthHeader();
			const { chunk, hash } = await getChunk(file, chunkNumber, chunkSize);
			return await uploadWithProgress(endpoints.upload(fileId, chunkNumber), {
				headers: {
					"Content-Type": "application/octet-stream",
					"Content-SHA256": hash,
					...authHeader
				},
				body: chunk,
				onProgress: (bytesUploaded) => onProgress?.(chunkNumber, bytesUploaded),
				signal: abortSignal
			}).catch((error) => {
				throw new Error(`Failed to upload chunk number`, { cause: error });
			});
		}
		async function uploadChunks({ file, fileId, chunkNumbers, abortSignal, onProgress }) {
			let uploadingChunks = 0;
			let chunksUploaded = 0;
			let isDone = false;
			for await (const chunkNumber of chunkNumbers) {
				await waitUploadChunkSlot(() => uploadingChunks, Date.now(), abortSignal);
				if (abortSignal.aborted) return;
				uploadingChunks++;
				uploadChunk({
					fileId,
					file,
					chunkNumber,
					abortSignal,
					onProgress
				}).catch((error) => {
					logger?.error("FS Api - Failed to upload chunk", error, {
						fileId,
						fileSize: file.size,
						chunkNumber,
						chunkSize
					});
				}).finally(() => {
					uploadingChunks--;
					chunksUploaded++;
					isDone = chunksUploaded === chunkNumbers.length;
				});
			}
			await waitForCompletion(() => isDone, abortSignal);
		}
		async function finalise({ retryNumber = 0, fileId, file, totalChunks, abortSignal, onProgress }) {
			if (abortSignal.aborted) throw new Error("Upload aborted");
			const authHeader = await getAuthHeader();
			const formBody = new URLSearchParams();
			formBody.set("fileName", file.name);
			formBody.set("fileSize", file.size.toString());
			formBody.set("chunksCount", totalChunks.toString());
			if (intent) formBody.set("intent", intent);
			const { missingChunks, correlationId } = await fetch(endpoints.finalise(fileId), {
				method: "POST",
				headers: {
					"Content-Type": "application/x-www-form-urlencoded",
					...authHeader
				},
				body: formBody
			}).then(async (response) => {
				try {
					if (!response.ok) return {
						missingChunks: (await response.json()).missing_chunks,
						correlationId: response.headers.get(CORRELATION_ID_HEADER)
					};
					return {};
				} catch (finaliseError) {
					throw Error(`Failed to finalise the upload: ${finaliseError}`);
				}
			});
			if (missingChunks) {
				if (retryNumber >= 8) throw new Error("Failed to finalise the upload");
				if (retryNumber === 3) logger?.error("FS Api - More that 3 finalise call retry required", /* @__PURE__ */ new Error("Failed to finalise"), {
					fileId,
					missingChunks,
					retryNumber,
					correlationId
				});
				for (const chunkNumber of missingChunks) onProgress?.(chunkNumber, 0);
				await uploadChunks({
					file,
					fileId,
					chunkNumbers: missingChunks,
					abortSignal,
					onProgress
				});
				return finalise({
					fileId,
					file,
					totalChunks,
					abortSignal,
					onProgress,
					retryNumber: retryNumber + 1
				});
			}
		}
		return {
			prepare: async () => {
				const authHeader = await getAuthHeader();
				const url = endpoints.prepare();
				try {
					return (await fetch(url, {
						method: "POST",
						headers: {
							"content-type": "application/x-www-form-urlencoded",
							...authHeader
						}
					}).then((res) => res.json())).file_id;
				} catch (prepareError) {
					throw new Error(`Failed to prepare the upload: ${prepareError}`);
				}
			},
			upload: async ({ file, fileId, abortSignal, onProgress }) => {
				const totalChunks = Math.ceil(file.size / chunkSize);
				const chunksStatus = getChunksStatusMap(file, chunkSize);
				function updateChunksProgress(chunkNumber, bytesUploaded) {
					const chunkStatus = chunksStatus.get(chunkNumber);
					if (!chunkStatus) return;
					chunkStatus.loaded = bytesUploaded;
					onProgress(getTotalUploaded(chunksStatus), file.size);
				}
				await uploadChunks({
					fileId,
					file,
					chunkNumbers: Array.from({ length: totalChunks }, (_, i) => i),
					abortSignal,
					onProgress: updateChunksProgress
				});
				try {
					await finalise({
						fileId,
						file,
						totalChunks,
						abortSignal
					});
				} catch (error) {
					throw new Error(`Failed to finalise the upload: ${fileId}`, { cause: error });
				}
			}
		};
	}
	//#endregion
	//#region src/adapters/file-service/adapter.ts
	/**
	* Provides a raw interface for the legacy File Services uploader
	*
	* Handles
	*
	* - Starting an upload
	* - Pausing an upload
	* - Resuming an upload
	* - Cancelling an upload
	* - Get the latest state of an upload
	*/
	var FileServiceUploaderAdapter = class {
		#file;
		#fileId;
		#events;
		#abortController;
		#getWebSocket;
		#fileServiceApi;
		#logger;
		constructor(file, options) {
			this.#logger = options.getLogger?.();
			this.#file = file;
			this.#fileServiceApi = fileServiceApi({
				intent: options.intent,
				getAuthorizationToken: options.getAuthorizationToken,
				logger: this.#logger
			});
			this.#abortController = new AbortController();
			this.#events = {
				onAssetAssigned: options.onAssetAssigned,
				onProgress: options.onProgress,
				onSuccess: options.onSuccess,
				onError: options.onError,
				onMetadata: options.onMetadata,
				onThumbnail: options.onThumbnail
			};
			this.#getWebSocket = options.getWebSocket;
		}
		async #listenForMetadata() {
			if (!this.#fileId) throw new Error("The file-id was not properly set! Can't listen for metadata.");
			const metadata = await this.#getWebSocket().listenForMetadata(this.#fileId);
			if (this.#abortController.signal.aborted) return;
			this.#events.onMetadata?.(metadata);
		}
		async #listenForThumbnail() {
			if (!this.#fileId) throw new Error("The file-id was not properly set! Can't listen for thumbnails.");
			const thumbnailUrl = await this.#getWebSocket().listenForThumbnail(this.#fileId);
			if (this.#abortController.signal.aborted) return;
			this.#events.onThumbnail?.(thumbnailUrl);
		}
		async startUpload() {
			try {
				this.#fileId = await this.#fileServiceApi.prepare();
				this.#events.onAssetAssigned?.(this.#fileId, this.#fileId);
			} catch (error) {
				this.#events.onError?.(error, { description: "Failed to prepare the file upload" });
			}
			if (!this.#fileId) return;
			await this.#getWebSocket().listenFileEvents(this.#fileId);
			if (this.#abortController.signal.aborted) return;
			if (this.#events.onMetadata) this.#listenForMetadata();
			if (this.#events.onThumbnail) this.#listenForThumbnail();
			this.#getWebSocket().listenForFileUploadSuccess(this.#fileId).then(() => {
				if (this.#abortController.signal.aborted || !this.#fileId) return;
				this.#events.onSuccess?.(this.#fileId, this.#fileId);
			});
			this.#fileServiceApi.upload({
				file: this.#file,
				fileId: this.#fileId,
				abortSignal: this.#abortController.signal,
				onProgress: (bytesUploaded, bytesTotal) => {
					this.#events.onProgress?.(bytesUploaded, bytesTotal);
				}
			}).catch((error) => {
				if (this.#abortController.signal.aborted) return;
				this.#events.onError?.(error, {
					description: "Failed to upload the file",
					fileId: this.#fileId
				});
			});
		}
		pauseUpload() {
			throw new Error("Not supported by FS adapter");
		}
		resumeUpload() {
			throw new Error("Not supported by FS adapter");
		}
		cancelUpload() {
			this.#abortController.abort();
		}
	};
	function createFileServiceUploaderAdapter(file, options) {
		return new FileServiceUploaderAdapter(file, options);
	}
	//#endregion
	exports.AssetUploadManager = AssetUploadManager;
	exports.UploadEventTarget = UploadEventTarget;
	exports.createAssetServiceAdapter = createAssetServiceAdapter;
	exports.createFakeWebSocketProvider = createFakeWebSocketProvider;
	exports.createFileServiceUploaderAdapter = createFileServiceUploaderAdapter;
});