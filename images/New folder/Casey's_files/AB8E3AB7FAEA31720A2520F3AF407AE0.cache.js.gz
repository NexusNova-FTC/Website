      });

      var mentionText = utils.htmlEncode(syntaxMessage);
      mentionsCollection.forEach(function (mention) {
        var formattedMention = Object.assign({}, mention, {value: utils.htmlEncode(mention.value)});
        var textSyntax = settings.templates.mentionItemSyntax(formattedMention);
        var textHighlight = settings.templates.mentionItemHighlight(formattedMention);
        mentionText = mentionText.replace(textSyntax, textHighlight);
      });

      mentionText = mentionText.replace(/\n/g, '<br />');
      mentionText = mentionText.replace(/ {2}/g, '&nbsp; ');

      elmInputBox.data('messageText', syntaxMessage);
      elmMentionsOverlay.find('div').html(mentionText);

      // Run callback
      if (typeof settings.onUpdate === 'function') {
        settings.onUpdate();
      }
    }

    function resetBuffer() {
      inputBuffer = [];
    }

    function updateMentionsCollection() {
      var inputText = getInputBoxValue();

      mentionsCollection = mentionsCollection.filter(function (mention) {
        return !!mention && !!mention.value && inputText.indexOf(mention.value) !== -1;
      });
    }

    function getMentionPositions(query) {
      var position = {
        start: -1,
        end: elmInputBox.caret()
      };

      var currentMessage = getInputBoxValue();
      var queryString = settings.triggerChar + query;

      var foundAt = currentMessage.indexOf(queryString);
      while (foundAt >= 0 && foundAt <= position.end) {
        position.start = foundAt;
        foundAt = currentMessage.indexOf(queryString, position.start + 1);
      }
      return position;
    }

    function addMention(mention, external) {
      var currentMessage = getInputBoxValue();
      var start = "";
      var end = "";
      var startEndIndex = 0;

      if( !external ){
        var position = getMentionPositions(currentDataQuery);

        start = currentMessage.substr(0, position.start);
        end = currentMessage.substr(position.end);
        startEndIndex = (start + mention.value).length;
      } else {
        var currentCaretPosition = elmInputBox.caret();

        start = currentMessage.substr(0, currentCaretPosition);
        end = currentMessage.substr(currentCaretPosition, currentMessage.length);
        startEndIndex = (start + mention.value).length;
      }

      mentionsCollection.push(mention);

      // Cleaning before inserting the value, otherwise auto-complete would be triggered with "old" inputbuffer
      resetBuffer();
      currentDataQuery = '';
      hideAutoComplete();

      var updatedMessageText = "";

      // Mentions & syntax message
      updatedMessageText = start + mention.value + end;

      elmInputBox.val(updatedMessageText);
      updateValues();

      // Set correct focus and selection
      elmInputBox.trigger('focus');
      utils.setCaratPosition(elmInputBox[0], startEndIndex);

      // Run callback
      if (typeof settings.onMentionAdd === 'function') {
        settings.onMentionAdd(mention);
      }
    }

    function getInputBoxValue() {
      return $.trim(elmInputBox.val());
    }

    function onAutoCompleteItemClick(e) {
      var elmTarget = $(this);

      if( elmTarget.hasClass(".mentions-input-result-ignore") ){
        return true;
      }

      var mention = autocompleteItemCollection[elmTarget.attr('data-uid')];

      addMention(mention, false);

      return false;
    }

    function onInputBoxClick(e) {
      resetBuffer();
    }

    function onInputBoxBlur(e) {
      hideAutoComplete();
    }

    function makeInputBuffer() {
      var position = getMentionPositions('');

      if (position.start < 0) {
        resetBuffer();
        hideAutoComplete();
      } else {
        var value = getInputBoxValue();
        inputBuffer = value.substr(position.start, position.end - position.start).split('');
      }
    }

    function onInputBoxInput(e) {
      makeInputBuffer();

      updateValues();
      updateMentionsCollection();

      var triggerCharIndex = inputBuffer.lastIndexOf(settings.triggerChar);
      if (triggerCharIndex > -1) {
        currentDataQuery = inputBuffer.slice(triggerCharIndex + 1).join('');
        currentDataQuery = utils.rtrim(currentDataQuery);

        setTimeout(doSearch.bind(this, currentDataQuery), 0);
      }
    }

    function onInputBoxKeyDown(e) {
      // This also matches HOME/END on OSX which is CMD+LEFT, CMD+RIGHT
      if (e.keyCode == KEY.LEFT || e.keyCode == KEY.RIGHT || e.keyCode == KEY.HOME || e.keyCode == KEY.END) {
        // Defer execution to ensure carat pos has changed after HOME/END keys
        setTimeout(resetBuffer, 0);

        // IE9 doesn't fire the oninput event when backspace or delete is pressed. This causes the highlighting
        // to stay on the screen whenever backspace is pressed after a highlighed word. This is simply a hack
        // to force updateValues() to fire when backspace/delete is pressed in IE9.
        if (navigator.userAgent.indexOf("MSIE 9") > -1) {
          setTimeout(updateValues, 0);
        }

        return;
      }

      if (!elmAutocompleteList.is(':visible')) {
        return true;
      }

      switch (e.keyCode) {
        case KEY.UP:
        case KEY.DOWN:
          var elmCurrentAutoCompleteItem = null;
          if (e.keyCode == KEY.DOWN) {
            if (elmActiveAutoCompleteItem && elmActiveAutoCompleteItem.length) {
              elmCurrentAutoCompleteItem = elmActiveAutoCompleteItem.next(".mentions-input-result");
            } else {
              elmCurrentAutoCompleteItem = elmAutocompleteList.find('li').first();
            }
          } else {
            elmCurrentAutoCompleteItem = $(elmActiveAutoCompleteItem).prev(".mentions-input-result");
          }

          if (elmCurrentAutoCompleteItem.length) {
            selectAutoCompleteItem(elmCurrentAutoCompleteItem);
          }

          return false;

        case KEY.RETURN:
        case KEY.TAB:
          if (elmActiveAutoCompleteItem && elmActiveAutoCompleteItem.length) {

            // small delay, so we could check if the list is visible, if so then prevent default enter functionality
            setTimeout(function(){elmActiveAutoCompleteItem.trigger('mousedown');},10);
            return false;
          }

          break;
      }

      return true;
    }

    function hideAutoComplete() {
      elmActiveAutoCompleteItem = null;
      elmAutocompleteList.empty().hide();
    }

    function selectAutoCompleteItem(elmItem) {
      elmItem.addClass(settings.classes.autoCompleteItemActive);
      elmItem.siblings().removeClass(settings.classes.autoCompleteItemActive);

      elmActiveAutoCompleteItem = elmItem;
    }

    function populateDropdown(query, results) {
      if (currentDataQuery !== query) {
        return;
      }

      elmAutocompleteList.show();

      if (!results.length) {
        hideAutoComplete();
        return;
      }

      elmAutocompleteList.empty();
      var elmDropDownList = $("<ul>").appendTo(elmAutocompleteList).hide();

      results.forEach(function (item, index) {
        var itemUid = uniqueId('mention_');

        autocompleteItemCollection[itemUid] = Object.assign({}, item, {value: item.name});

        var elmListItem;
        switch( item.type ){
          case "seperator":
            elmListItem = $(settings.templates.autocompleteListSeperator({
              'content' : utils.highlightTerm(utils.htmlEncode((item.name)), query)
            })).attr('data-uid', itemUid);
          break;
          default:
            elmListItem = $(settings.templates.autocompleteListItem({
              'id'      : utils.htmlEncode(item.id),
              'display' : utils.htmlEncode(item.name),
              'type'    : utils.htmlEncode(item.type),
              'content' : utils.highlightTerm(utils.htmlEncode((item.name)), query)
            })).attr('data-uid', itemUid);
          break;
        }

        if (index === 0) {
          selectAutoCompleteItem(elmListItem);
        }

        if (settings.showAvatars && item.type != "seperator" ) {
          var elmIcon;

          if (item.avatar) {
            elmIcon = $(settings.templates.autocompleteListItemAvatar({ avatar : item.avatar }));
          } else {
            elmIcon = $(settings.templates.autocompleteListItemIcon({ icon : item.icon }));
          }
          elmIcon.prependTo(elmListItem);
        }
        elmListItem = elmListItem.appendTo(elmDropDownList);
      });

      elmAutocompleteList.show();
      elmDropDownList.show();
    }

    function doSearch(query) {
      if (query && query.length && query.length >= settings.minChars) {
        settings.onDataRequest.call(this, 'search', query, function (responseData) {
          populateDropdown(query, responseData);
        });
      } else {
        hideAutoComplete();
      }
    }

    function readMentions() {
      if( elmInputBox.attr("data-mentions") !== undefined ){
        var tags = elmInputBox.attr("data-mentions");

        var regexgi = /@\[(.*?)\]\(([a-zA-Z]+):([a-zA-Z0-9]+)\)/gi;
        var regex = /@\[(.*?)\]\(([a-zA-Z]+):([a-zA-Z0-9]+)\)/;

        var mentions = tags.match( regexgi );
        mentionsCollection = [];
        
        if(mentions !== null){

          for(var i=0; i<mentions.length; i++){
            var mentionString = mentions[i];
            var parts = mentionString.match(regex);

            var mention = {
              id : parts[3],
              name : parts[1],
              avatar : "",
              type : parts[2],
              value : parts[1]
            };
            
            mentionsCollection.push(mention);
          }
        }

        updateValues();
      } else {
        resetInput();
      }
    }

    function resetInput() {
      elmInputBox.val('');
      mentionsCollection = [];
      updateValues();
    }

    function destroyMentions() {
      // Unbind events
      elmInputBox.removeAttr('data-mentions-input');
      elmInputBox.off('keydown.mentionsInput', onInputBoxKeyDown);
      elmInputBox.off('input.mentionsInput', onInputBoxInput);
      elmInputBox.off('click.mentionsInput', onInputBoxClick);
      elmInputBox.off('blur.mentionsInput', onInputBoxBlur);
      elmAutocompleteList.off('mousedown.mentionsInput', 'li.mentions-input-result');

      // Move input back to original position
      elmInputBox.insertBefore( elmInputWrapper.children(".mentions-input-box") );
      elmInputWrapper.children(".mentions-input-box").remove();
      elmInputWrapper.hide().css({"width":"100px"}).removeAttr("style");
    }

    // Public methods
    return {
      init : function (domTarget) {

        domInput = domTarget;

        compileTemplates();
        initTextarea();
        initAutocomplete();
        initMentionsOverlay();
        readMentions();

        if( settings.prefillMention ) {
          addMention( settings.prefillMention, false );
        }

      },

      val : function (callback) {
        if (typeof callback !== 'function') {
          return;
        }

        var value = mentionsCollection.length ? elmInputBox.data('messageText') : getInputBoxValue();
        callback.call(this, value);
      },

      reset : function () {
        resetInput();
      },

      getMentions : function (callback) {
        if (typeof callback !== 'function') {
          return;
        }

        callback.call(this, mentionsCollection);
      },

      update : function () {
        updateValues();
      },

      add : function (mention) {
        addMention(mention, true);
      },

      destroy : function () {
        destroyMentions();
      }
    };
  };

  $.fn.mentionsInput = function (method, settings) {

    var outerArguments = arguments;

    if (typeof method === 'object' || !method) {
      settings = method;
    }

    return this.each(function () {
      var instance = $.data(this, 'mentionsInput') || $.data(this, 'mentionsInput', new MentionsInput(settings));

      if (typeof instance[method] === 'function') {
        return instance[method].apply(this, Array.prototype.slice.call(outerArguments, 1));

      } else if (typeof method === 'object' || !method) {
        return instance.init.call(this, this);

      } else {
        $.error('Method ' + method + ' does not exist');
      }

    });
  };

