query searchAssets($filter: AssetFilter!, $language: String!) {
    searchAssets(filter: $filter) {
      tags {
        nodes {
          id
          name
          assetCount
        }
      }
      metapropertyFilters {
        nodes {
          __typename
          ... on Smartfilter {
            id
            label(language: $language)
            metaproperties {
              id
              label(language: $language)
              options {
                id
                label(language: $language)
                assetCount
              }
            }
            icon
            zIndex
          }
          ... on Metaproperty {
            id
            label(language: $language)
            options {
              id
              label(language: $language)
