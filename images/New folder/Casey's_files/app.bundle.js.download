<title>Redirecting...</title>
<style>
    @keyframes cv-spinner-animation {
        to {
            transform:rotate(1turn)
        }
    }

    .cv-spinner {
        position: relative;
        display: inline-block;
        padding: 175px 0 100px;
        width: 100%;
        height: auto;
        background: #fff;
        box-sizing: border-box;
    }
    
    .cv-spinner:before {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 40px;
        height: 40px;
        margin-top: -20px;
        margin-left: -20px;
        box-sizing: border-box;
        border-top: 3px solid #7e8890;
        border-right: 3px solid transparent;
        border-radius: 50%;
        content: "";
        animation: cv-spinner-animation .8s linear infinite;
        z-index: 3;
    }
