            30%, 50%, 70% { transform: translateX(-6px); }
            40%, 60% { transform: translateX(6px); }
        }
        @keyframes karel-slide-in {
            from { transform: translateY(8px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        @keyframes karel-confetti-fall {
            0% { transform: translate(var(--start-x), -20px) rotate(0deg); opacity: 1; }
            100% {
                transform: translate(calc(var(--start-x) + var(--drift)), 100vh) rotate(var(--spin));
                opacity: 0.85;
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .karel-row-animated, .karel-row-shake { animation: none !important; }
        }
