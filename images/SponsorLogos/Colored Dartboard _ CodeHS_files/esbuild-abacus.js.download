    border: none;
    background: transparent;
    color: #5f5f5f;
    border-radius: 3px;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    &:hover:enabled {
        background: #ececec;
    }
    &:disabled {
        opacity: 0.4;
        cursor: default;
    }
`,BB=Nn.default.div`
    color: #757575;
    margin: 8px 2px 4px;
`,VB=Nn.default.div`
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px 2px 4px;
    padding: 6px 8px;
