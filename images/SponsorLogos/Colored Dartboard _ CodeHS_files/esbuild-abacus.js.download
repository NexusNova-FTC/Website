`,kT=Nn.default.button`
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: #6b7280;
    cursor: pointer;
    transition:
        background-color 0.1s ease-out,
        color 0.1s ease-out;
    &:hover:not(:disabled) {
        background: #e5e7eb;
        color: #1f2937;
    }
    &:focus-visible {
        outline: 2px solid var(--siteBlue, #26a9e1);
        outline-offset: -2px;
    }
    &:disabled {
        opacity: 0.35;
        cursor: default;
    }
