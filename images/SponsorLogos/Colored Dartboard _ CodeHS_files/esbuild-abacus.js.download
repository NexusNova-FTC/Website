        .vibe-code-markdown p { margin: 0 0 8px 0; }
        .vibe-code-markdown p:last-child { margin-bottom: 0; }
        .vibe-code-markdown h1,
        .vibe-code-markdown h2,
        .vibe-code-markdown h3,
        .vibe-code-markdown h4,
        .vibe-code-markdown h5,
        .vibe-code-markdown h6 {
            color: #1e293b;
            margin-top: 16px;
            margin-bottom: 8px;
            font-weight: 600;
            line-height: 1.3;
        }
        .vibe-code-markdown code {
            background: #f1f5f9;
            color: #e11d48;
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 14px;
            border: 1px solid #e2e8f0;
        }
        .vibe-code-markdown pre,
        .vibe-code-markdown pre.prettyprint {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            overflow-x: auto;
            margin: 16px 0;
            max-width: 100%;
        }
        .vibe-code-markdown pre code {
            background: transparent;
            color: inherit;
            padding: 0;
            border: none;
            border-radius: 0;
            font-size: 0.95em;
            line-height: 1.5;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
        }
        .vibe-code-markdown a {
            color: var(--siteBlue);
        }
        .vibe-code-markdown blockquote {
            border-left: 4px solid #3b82f6;
            padding-left: 16px;
            margin: 16px 0;
            color: #64748b;
            font-style: italic;
        }
        .vibe-code-markdown table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
            font-size: 14px;
            display: block;
            overflow-x: auto;
        }
        .vibe-code-markdown th,
        .vibe-code-markdown td {
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            text-align: left;
            word-break: normal;
            overflow-wrap: normal;
        }
        .vibe-code-markdown th {
            background-color: #e5e7eb;
            font-weight: 600;
            white-space: nowrap;
        }
        .vibe-code-markdown ol, .vibe-code-markdown ul {
            margin: 8px 0;
            padding-left: 20px;
        }
        .vibe-code-markdown li { margin-bottom: 4px; }
        .vibe-code-markdown strong { font-weight: 600; }
        .vibe-code-markdown em { font-style: italic; }

        /* User chat bubbles use a blue background; keep prose light and code blocks readable. */
        .vibe-code-markdown.vibe-code-markdown-user {
            color: #ffffff;
        }
        .vibe-code-markdown.vibe-code-markdown-user pre,
        .vibe-code-markdown.vibe-code-markdown-user pre.prettyprint {
            color: #0f172a;
        }
        .vibe-code-markdown.vibe-code-markdown-user pre code {
            color: inherit;
        }
        .vibe-code-markdown.vibe-code-markdown-user p code,
        .vibe-code-markdown.vibe-code-markdown-user li code {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.35);
        }
        .vibe-code-markdown.vibe-code-markdown-user a {
            color: #e0f2fe;
        }
        .vibe-code-markdown.vibe-code-markdown-user blockquote {
            color: #e0f2fe;
            border-left-color: rgba(255, 255, 255, 0.55);
        }
        .vibe-code-user-bubble-wrap {
            position: relative;
            max-width: 85%;
            margin-bottom: 16px;
        }
        .vibe-code-user-copy-btn {
            position: absolute;
            left: 8px;
            bottom: -14px;
            opacity: 0;
            pointer-events: none;
            transform: translateY(3px);
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
            transition: opacity 0.12s ease, transform 0.12s ease, background-color 0.15s ease, border-color 0.15s ease;
        }
        .vibe-code-user-bubble-wrap:hover .vibe-code-user-copy-btn {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
