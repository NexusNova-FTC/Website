    border-radius: 3px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    &:hover {
        background: #e3f3fb;
    }
`,WB=Nn.default.div`
