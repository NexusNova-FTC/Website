`+n.map(function(e,t){return`            runSuite(() -> `+e+`.main(args), allTests, `+t+`);`}).join(`
`)+`

        JSONObject result = new JSONObject();
        result.put("tests", allTests);
        System.out.println("__unittests__" + result.toString());
    }

    private static void runSuite(Runnable suite, JSONArray allTests, int suiteIndex) {
        PrintStream originalOut = System.out;
        ByteArrayOutputStream captured = new ByteArrayOutputStream();
        System.setOut(new PrintStream(captured));
        try { suite.run(); } catch (Exception e) {
            System.setOut(originalOut);
            JSONObject err = new JSONObject();
            err.put("success", false);
            err.put("test", "Suite Error");
            err.put("message", e.getMessage());
            err.put("suiteIndex", suiteIndex);
            allTests.put(err);
            return;
        }
        System.setOut(originalOut);
        String output = captured.toString();
        int idx = output.indexOf("__unittests__");
        if (idx >= 0) {
            try {
                String json = output.substring(idx + 13);
                JSONObject obj = new JSONObject(json);
                JSONArray tests = obj.getJSONArray("tests");
                for (int i = 0; i < tests.length(); i++) {
                    JSONObject t = tests.getJSONObject(i);
                    t.put("suiteIndex", suiteIndex);
                    allTests.put(t);
                }
            } catch (Exception e) {}
        }
    }
}
