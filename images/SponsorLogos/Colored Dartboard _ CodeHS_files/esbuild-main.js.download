    <div class="codehs-form">
        <div class="create-custom-badge">
            <form enctype="multipart/form-data" id="js-upload-form" action="" method="post">
                <input name="file" type="file" id="img-upload" accept="image/*">
            </form>
            <div class="badge-info">
                <div class="badge-name">
                    <label for="custom-badge-name">Badge Name</label>
                    <input type="text" id="custom-badge-name" placeholder="Enter badge name" maxlength="20"{{#if badgeName}} value="{{badgeName}}"{{/if}}>
                    <div class="char-count"><span class="current-count" id="name-count">0</span>/20</div>
                </div>
                <div class="badge-description-wrapper">
                    <label for="custom-badge-description">Description</label>
                    <textarea id="custom-badge-description" class="custom-badge-description" placeholder="What does a student need to do to earn this badge?" maxlength="90">{{#if badgeDescription}}{{badgeDescription}}{{/if}}</textarea>
                    <div class="char-count"><span class="current-count" id="description-count">0</span>/90</div>
                </div>
            </div>
            <div class="custom-badge-upload">
                <div class="badge-preview-container">
                    <div class="badge-border">
                        <img class="border" src="{{borderImg}}" alt="Badge border">
                        <img class="badge-icon" id="custom-badge-img" src="{{badgeImgUrl}}" data-img_name="{{badgeImg}}" alt="Badge preview">
                    </div>
                    <div class="badge-preview-overlay">
                        <span class="preview-text">Badge Preview</span>
                    </div>
                </div>
                <input type="hidden" id="badge-img-name"/>
                <a href="#" id="custombadge-file-select" class="btn btn-main-blue">Upload Image</a>
                <p class="upload-hint">Drag an image here or click to upload. Square images work best (recommended: 200x200px)</p>
            </div>
        </div>
    </div>
