                    class="deal-suggestion-photo"
                    alt="{{am.name}}"
                    rel="tooltip"
                    title="{{am.name}}"
                >
            {{!-- Otherwise, show each image if present --}}
            {{else}}
                {{#if am.photo}}
                <img
