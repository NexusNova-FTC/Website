                    class="deal-suggestion-photo {{#if csm.photo}}deal-suggestion-photo--am{{/if}}"
                    alt="{{am.name}}"
                    rel="tooltip"
                    title="{{am.name}}"
                >
                {{/if}}
                {{#if csm.photo}}
                <img
                    src="{{csm.photo}}"
                    class="deal-suggestion-photo {{#if am.photo}}deal-suggestion-photo--csm{{/if}}"
                    alt="{{csm.name}}"
                    rel="tooltip"
                    title="{{csm.name}}"
                >
                {{/if}}
            {{/if}}
        </div>
    </div>
</a>
