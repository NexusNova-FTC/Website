            .chs-grid-empty-ball {
                animation: bounceToStop 1.5s ease-out forwards;
            }
            .chs-grid-empty-ball-shadow {
                animation: shadowGrowShrink 1.5s ease-out forwards;
            }
            /* Respect the OS "reduce motion" setting. For this to land where
               the animation would have settled rather than somewhere else, each
               element's BASE style has to equal its keyframes' 100% values --
               ball at translateY(0) scale(1), shadow at 20px wide and opacity
               0.3. That is an invariant to keep, not something that holds for
               free: the shadow's base was missing opacity, which defaults to 1,
               so it rendered noticeably darker whenever the animation was
               suppressed. If you touch either keyframe set, re-check the base.

               This lives in CSS rather than a matchMedia check in JS so it also
               applies when the user changes the setting without reloading, and
               it's why the animation moved off the elements' inline styles:
               an inline animation declaration would win over this rule. */
            @media (prefers-reduced-motion: reduce) {
                .chs-grid-empty-ball,
                .chs-grid-empty-ball-shadow {
                    animation: none;
                }
            }
            @keyframes bounceToStop {
                0% {
                    transform: translateY(0) scale(1);
                }
                15% {
                    transform: translateY(-30px) scale(1.1);
                }
                30% {
                    transform: translateY(0) scale(1);
                }
                45% {
                    transform: translateY(-20px) scale(1.05);
                }
                60% {
                    transform: translateY(0) scale(1);
                }
                75% {
                    transform: translateY(-10px) scale(1.02);
                }
                90% {
                    transform: translateY(0) scale(1);
                }
                100% {
                    transform: translateY(0) scale(1);
                }
            }
            @keyframes shadowGrowShrink {
                0% {
                    width: 20px;
                    opacity: 0.3;
                }
                15% {
                    width: 12px;
                    opacity: 0.15;
                }
                30% {
                    width: 20px;
                    opacity: 0.3;
                }
                45% {
                    width: 16px;
                    opacity: 0.2;
                }
                60% {
                    width: 20px;
                    opacity: 0.3;
                }
                75% {
                    width: 18px;
                    opacity: 0.25;
                }
                90% {
                    width: 20px;
                    opacity: 0.3;
                }
                100% {
                    width: 20px;
                    opacity: 0.3;
